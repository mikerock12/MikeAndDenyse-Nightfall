#pragma code_page(65001)
#include <windows.h>
101 ICON "@SLT_BRANDING_DIR@/AppIcon.ico"
102 RCDATA "@SLT_BRANDING_DIR@/AppIcon.png"

1 VERSIONINFO
 FILEVERSION @SLT_VERSION_COMMAS@
 PRODUCTVERSION @SLT_VERSION_COMMAS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Smells Like Tech"
   VALUE "FileDescription", "@SLT_PRODUCT_NAME@"
   VALUE "FileVersion", "@SLT_VERSION@"
   VALUE "ProductName", "@SLT_PRODUCT_NAME@"
   VALUE "ProductVersion", "@SLT_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
